  {
    "id": "q1",
    "title": "Total Revenue, Units Sold & Order Averages",
    "question": "What is total revenue, total quantity, and transaction count?",
    "sql": "SELECT \n    COUNT(*) AS total_transactions,\n    SUM(Quantity_Sold) AS total_units_sold,\n    SUM(Revenue) AS total_revenue_inr,\n    ROUND(AVG(Revenue), 2) AS avg_transaction_value,\n    ROUND(AVG(Quantity_Sold), 2) AS avg_units_per_order\nFROM kmf_sales;",
    "columns": [
      "total_transactions",
      "total_units_sold",
      "total_revenue_inr",
      "avg_transaction_value",
      "avg_units_per_order"
    ],
    "rows": [
      {
        "total_transactions": 4982,
        "total_units_sold": 1736152,
        "total_revenue_inr": 111189799,
        "avg_transaction_value": 22318.31,
        "avg_units_per_order": 348.48
      }
    ],
    "row_count": 1
